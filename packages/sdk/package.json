{
  "name": "@clarity-2/sdk",
  "version": "3.0.0",
  "private": true,
  "description": "Clarity Analytics SDK — builds to apps/web/public/clarity.js",
  "scripts": {
    "build":     "tsc --noEmit && node scripts/bundle.mjs",
