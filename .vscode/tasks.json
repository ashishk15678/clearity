{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Test All",
      "type": "shell",
      "command": "pnpm test && cargo test --workspace",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Build All",
      "type": "shell",
      "command": "pnpm build && cargo build --workspace --release",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}